{
  "name": "matgebra",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "1-12. sinif geometri ve olasilik icin dinamik matematik atolyesi",
  "workspaces": [
    "packages/*",
    "apps/*",
    "db"
  ],
  "scripts": {
    "web": "npm run dev -w @matgebra/web",
    "api": "npm run dev -w @matgebra/api",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:api\" \"npm:web\"",
    "db:sema": "npm run sema -w @matgebra/db",
    "db:goc": "npm run goc -w @matgebra/db",
    "db:aktar": "npm run aktar -w @matgebra/db",
    "db:tohum": "npm run tohum -w @matgebra/db",
    "db:kur": "npm run kur -w @matgebra/db",
    "tip": "tsc --build --pretty"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
